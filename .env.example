HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=0

# MySQL is preferred; if it's unreachable at startup the app automatically
# falls back to a local SQLite file instead (see README > Database).
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/speed_detection

# Path to the YOLO checkpoint to load, relative to the project root.
YOLO_WEIGHTS_PATH=weights/yolo26m.pt

# CCTV portal to crawl for camera streams, and the fallback stream if
# crawling finds nothing.
CCTV_STREAM_URL=https://cctv.banjarbarukota.go.id/CCTV

# Speed estimation
PIXELS_PER_METER=8.0
SPEED_LIMIT=60.0
MIN_SPEED=5.0
MAX_SPEED=240.0

# Storage
SNAPSHOT_DIR=static/snapshot
LOG_DIR=logs
